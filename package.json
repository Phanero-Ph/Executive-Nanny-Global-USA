  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.56.0",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "nodemailer": "^10.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15"
