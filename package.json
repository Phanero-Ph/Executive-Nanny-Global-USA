    "test:messaging": "node scripts/test-messaging.mjs",
    "stripe:recover": "tsx scripts/recover-stripe.ts",
    "production:check": "node scripts/check-production-env.mjs",
    "chat:cleanup": "tsx scripts/cleanup-chat-uploads.ts",
    "test:chat-attachments": "node scripts/test-chat-attachments.mjs",
    "test:chat-controls": "node scripts/test-chat-controls.mjs",
    "test:admin-permissions": "node scripts/test-admin-permissions.mjs"
